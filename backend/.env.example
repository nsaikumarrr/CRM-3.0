# ── CRM 3.0 Backend Environment ──────────────────────────────
APP_NAME=Tzmicha CRM 3.0 Backend
APP_ENV=development
DEBUG=true
PORT=8000

# ── Database (NEW Supabase project) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@db.YOUR-CRM3.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR-CRM3-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── AI ────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AI_SERVICE_URL=http://localhost:8001

# ── WhatsApp ──────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# ── Encryption ────────────────────────────────────────────────
ENCRYPTION_KEY=your-32-char-aes-256-key-here!!!

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,https://your-crm3-domain.com
